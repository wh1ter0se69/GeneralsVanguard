{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeneralsX Launcher",
  "mainBinaryName": "GeneralsX Launcher",
  "version": "0.9.71",
  "identifier": "dev.wh1ter0se.generalsx.launcher",
  "build": {
    "frontendDist": "../../../design/launcher",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GeneralsX",
        "url": "screens/MainWeb.html",
        "width": 1280,
        "height": 760,
        "resizable": true,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#141416"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "resources": { "../../../LICENSE.md": "LICENSE.md", "../../../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt" },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}