/* GeneralsXUpdate.exe's identity in Task Manager and Explorer.
 *
 * GeneralsX @bugfix Claude 19/09/2026 The owner found three "GeneralsXUpdate.exe" rows in Task
 * Manager with the generic blank-exe icon, no description and no publisher, downloading after the
 * launcher had closed - and said, fairly, that it looked suspicious. A program with no version
 * resource shows exactly that. This gives it the launcher's own icon and a plain name.
 *
 * THE ICON IS THE TAURI LAUNCHER'S, referenced rather than copied, so the updater and the window a
 * player actually sees cannot drift apart. rc.exe accepts its PNG-compressed entries.
 *
 * "Updater" in FileDescription does not trip Windows' installer-detection heuristic: that heuristic
 * applies to 32-bit executables only, and this is x64 with an asInvoker manifest besides. */
#include <winver.h>

1 ICON "..\\..\\..\\launcher-rs\\gxlauncher\\icons\\icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "GeneralsX"
            VALUE "FileDescription",  "GeneralsX Updater"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "GeneralsXUpdate"
            VALUE "OriginalFilename", "GeneralsXUpdate.exe"
            VALUE "ProductName",      "GeneralsX"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
