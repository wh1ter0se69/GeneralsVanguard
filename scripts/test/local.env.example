# Copy to local.env and fill in your own hosts. local.env is gitignored.
# Env vars override these, so CI and one-off runs are unaffected.
VPS="${VPS:-root@your-linux-host}"        # linux peer, also the relay host
WIN="${WIN:-User@your-windows-host}"      # windows peer (xplat-3platform-lobby.sh)
WIN_HOST="${WIN_HOST:-User@your-windows-host}"  # windows peer (xplat-lan-soak.sh)
MAC_IP="${MAC_IP:-your-mac-lan-ip}"          # LAN address the windows peer dials (xplat-lan-soak.sh)
RELAY_IP="${RELAY_IP:-your-relay-host}"   # relay address written into Options.ini

# iOS install target for scripts/build/ios/package-ios-zh.sh. Either identifier works: the
# CoreDevice UUID (8-4-4-4-12, the "Identifier" column of `xcrun devicectl list devices`) or
# the hardware UDID (8-16, printed by `xcrun devicectl device info details --device <UUID>`).
#
# Leave it unset if exactly one iPad is paired with the Mac - the script selects that one. Set
# it when more than one is, or when the target is not an iPad: rather than guessing, the script
# stops and asks. It used to take whichever device devicectl listed first, which is alphabetical
# by device name, so a rename could redirect an install to somebody else's phone.
#
# --device on the command line overrides this, and so does GX_IOS_DEVICE in the environment.
#GX_IOS_DEVICE="${GX_IOS_DEVICE:-00000000-0000-0000-0000-000000000000}"

# Linux host that BUILDS the launcher AppImage. Deliberately separate from VPS: VPS is the relay
# host, and provisioning WebKit dev packages plus a multi-minute Rust build on the machine serving
# live matches is not something a script should decide on its own. If this is left equal to VPS,
# scripts/build/launcher/provision-linux.sh additionally requires GX_ALLOW_RELAY_HOST_BUILD=1.
GX_LINUX_BUILD_HOST="${GX_LINUX_BUILD_HOST:-root@your-linux-build-host}"

# The relay list, in publish-bootstrap.sh's own --relay form, space separated. Read by
# scripts/build/launcher/measure-manifest-prefix.sh and verify-with-publisher.sh so that the
# manifest's fixed byte cost is measured rather than guessed. HOST:PORT:REGION; an empty PORT
# means the default 8086.
GX_RELAY_SPECS="${GX_RELAY_SPECS:-relay1.your-domain:8086:eu relay2.your-domain::us}"

# The relays as SSH DESTINATIONS, space separated, one per relay. Read by
# scripts/relay/install-moderation-refresh.sh, which installs the moderation refresher and its
# systemd timer on every relay.
#
# Deliberately NOT the same variable as GX_RELAY_SPECS above. That one is HOST:PORT:REGION - the
# address players send game packets to, which is what goes in the signed manifest. This one is an
# ssh destination and carries a login. A relay behind a CNAME or a load balancer has a different
# answer for each, and conflating them installs onto the wrong box or onto none.
#
# Left unset it falls back to VPS, which is correct while there is exactly one relay and it is the
# same host.
#GX_RELAY_SSH="${GX_RELAY_SSH:-root@your-relay-host root@your-second-relay-host}"
